"""
analyze_best_parameters.py
===========================

Scientific analysis of “best_parameters.csv” files, such as those generated by
BluePyOpt / Blue Brain Project optimization workflows for biophysical
neuron models.

Expected file format (CSV, columns: “parameter,value”):
    ephys.passive.soma.Ra,140.20831294853414
    ephys.NaTs2_t.soma.gNaTs2_tbar,0.6492224930632599
    ...

The parameter names follow this convention:
    ephys.<mechanism>.<region>.<property>

where <region> is typically soma/axon/apical/basal/all.

FEATURES
----------------
1. Import one or more CSV files (e.g., multiple optimization runs /
   seeds / cells) and merge them into a “tidy” long-format DataFrame.
2. Break down parameter names into mechanism, region, and property.
3. Descriptive statistics:
     - Single file: sorted summary table, key metrics per region/mechanism
     - Multiple files: mean, standard deviation, coefficient of variation (CV), and
       min/max per parameter across all runs, to assess the
       convergence/robustness of the optimization.
4. Visualizations (PNG, publication-ready, log-scaled where necessary):
     - Bar chart of all parameter values, grouped by region
     - If >1 file: Box plots per parameter across all runs
     - If >1 file: Correlation heatmap between parameters
     - If >=3 files: PCA scatter plot of the runs (Similarity of the fits)
5. Export:
     - summary_stats.csv (key metrics)
     - long_format.csv (processed raw data for further analysis, e.g., in R/SPSS)
     - PNG figures
     - analysis_report.md (short, automatically generated text report)

USAGE
----------
    # Single file
    python analyze_best_parameters.py best_parameters.csv

    # Multiple files / all matching files in a folder
    python analyze_best_parameters.py “results/*.csv” -o output_dir

    # Explicit list
    python analyze_best_parameters.py run1.csv run2.csv run3.csv

Dependencies: pandas, numpy, matplotlib, seaborn, scikit-learn (nur für PCA)
"""

import argparse
import glob
import sys
from pathlib import Path

import numpy as np
import pandas as pd
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import seaborn as sns

sns.set_theme(style="whitegrid", context="talk")

REGION_ORDER = ["all", "soma", "axon", "apical", "basal", "other"]
REGION_PALETTE = {
    "soma": "#1b9e77",
    "axon": "#d95f02",
    "apical": "#7570b3",
    "basal": "#e7298a",
    "all": "#666666",
    "other": "#999999",
}


# --------------------------------------------------------------------------- #
# Import & Process
# --------------------------------------------------------------------------- #
def resolve_input_files(inputs: list[str]) -> list[Path]:
    files: list[Path] = []
    for pattern in inputs:
        matches = sorted(glob.glob(pattern))
        if not matches:
            if Path(pattern).exists():
                matches = [pattern]
            else:
                print(f"Warning: No hit for pattern '{pattern}'", file=sys.stderr)
        files.extend(Path(m) for m in matches)
    seen = set()
    unique_files = []
    for f in files:
        if f not in seen:
            seen.add(f)
            unique_files.append(f)
    return unique_files


def parse_parameter_name(name: str) -> tuple[str, str, str]:
    parts = name.split(".")
    if len(parts) == 4:
        _, mechanism, region, prop = parts
    elif len(parts) == 3:
        mechanism, region, prop = parts
    else:
        mechanism, region, prop = name, "other", name
    if region not in REGION_ORDER:
        region = region if region in REGION_PALETTE else "other"
    return mechanism, region, prop


def load_files(files: list[Path]) -> pd.DataFrame:
    frames = []
    for f in files:
        df = pd.read_csv(f)
        cols = {c.lower(): c for c in df.columns}
        if "parameter" not in cols or "value" not in cols:
            raise ValueError(
                f"File '{f}' does not contain the expected columns 'parameter,value' "
                f"(found: {list(df.columns)})"
            )
        df = df.rename(columns={cols["parameter"]: "parameter", cols["value"]: "value"})
        df["run"] = f.stem
        df["source_file"] = str(f)
        frames.append(df[["run", "source_file", "parameter", "value"]])

    long_df = pd.concat(frames, ignore_index=True)
    parsed = long_df["parameter"].apply(parse_parameter_name)
    long_df["mechanism"] = parsed.apply(lambda t: t[0])
    long_df["region"] = parsed.apply(lambda t: t[1])
    long_df["property"] = parsed.apply(lambda t: t[2])
    long_df["abs_value"] = long_df["value"].abs()
    # log10 nur für positive Werte sinnvoll definiert
    with np.errstate(divide="ignore", invalid="ignore"):
        long_df["log10_abs_value"] = np.where(
            long_df["abs_value"] > 0, np.log10(long_df["abs_value"]), np.nan
        )
    return long_df


# --------------------------------------------------------------------------- #
# Statistik
# --------------------------------------------------------------------------- #
def compute_summary(long_df: pd.DataFrame) -> pd.DataFrame:
    grp = long_df.groupby(["parameter", "mechanism", "region", "property"])["value"]
    summary = grp.agg(
        n_runs="count",
        mean="mean",
        std="std",
        min="min",
        max="max",
        median="median",
    ).reset_index()
    summary["cv_percent"] = (summary["std"] / summary["mean"].abs()) * 100
    summary = summary.sort_values(["region", "mechanism", "property"]).reset_index(drop=True)
    return summary


def region_mechanism_overview(long_df: pd.DataFrame) -> pd.DataFrame:
    ov = (
        long_df.groupby(["region", "mechanism"])
        .agg(n_parameters=("parameter", "nunique"), mean_log10_abs_value=("log10_abs_value", "mean"))
        .reset_index()
        .sort_values(["region", "mechanism"])
    )
    return ov


# --------------------------------------------------------------------------- #
# Visualisierung
# --------------------------------------------------------------------------- #
def plot_parameter_bar(long_df: pd.DataFrame, outdir: Path, single_run: bool):
    agg = (
        long_df.groupby(["parameter", "region"])["value"]
        .mean()
        .reset_index()
        .sort_values(["region", "parameter"])
    )
    agg["abs_value"] = agg["value"].abs()

    fig, ax = plt.subplots(figsize=(10, max(6, 0.28 * len(agg))))
    colors = agg["region"].map(REGION_PALETTE).fillna("#999999")
    bars = ax.barh(agg["parameter"], agg["abs_value"], color=colors)
    ax.set_xscale("log")
    ax.set_xlabel("|Parameterwert| (log-Skala)")
    ax.set_title(
        + ("" if single_run else " (Mittelwert über Läufe)")
    )
    ax.invert_yaxis()

    handles = [plt.Rectangle((0, 0), 1, 1, color=c) for c in REGION_PALETTE.values()]
    ax.legend(handles, REGION_PALETTE.keys(), title="Region", loc="lower right", frameon=True)
    fig.tight_layout()
    fig.savefig(outdir / "parameter_overview_by_region.png", dpi=200)
    plt.close(fig)


def plot_boxplots(long_df: pd.DataFrame, outdir: Path):
    fig, ax = plt.subplots(figsize=(10, max(6, 0.28 * long_df["parameter"].nunique())))
    order = sorted(long_df["parameter"].unique())
    sns.boxplot(
        data=long_df, y="parameter", x="value", order=order, ax=ax,
        hue="region", palette=REGION_PALETTE, dodge=False,
    )
    ax.set_xscale("symlog")
    ax.set_xlabel("Parameterwert (symlog-Skala)")
    ax.set_title("Streuung der Parameterwerte über alle Optimierungsläufe")
    ax.legend(title="Region", bbox_to_anchor=(1.02, 1), loc="upper left")
    fig.tight_layout()
    fig.savefig(outdir / "parameter_boxplots_across_runs.png", dpi=200)
    plt.close(fig)


def plot_correlation_heatmap(long_df: pd.DataFrame, outdir: Path):
    wide = long_df.pivot_table(index="run", columns="parameter", values="value")
    corr = wide.corr()
    fig, ax = plt.subplots(figsize=(0.4 * len(corr) + 4, 0.4 * len(corr) + 4))
    sns.heatmap(
        corr, cmap="RdBu_r", vmin=-1, vmax=1, center=0, ax=ax,
        square=True, cbar_kws={"label": "Pearson r"},
    )
    ax.set_title("Korrelation zwischen Parametern über alle Läufe")
    fig.tight_layout()
    fig.savefig(outdir / "parameter_correlation_heatmap.png", dpi=200)
    plt.close(fig)


def plot_pca(long_df: pd.DataFrame, outdir: Path):
    from sklearn.decomposition import PCA
    from sklearn.preprocessing import StandardScaler

    wide = long_df.pivot_table(index="run", columns="parameter", values="value").dropna(axis=1)
    if wide.shape[0] < 3 or wide.shape[1] < 2:
        return
    scaled = StandardScaler().fit_transform(wide.values)
    pca = PCA(n_components=2)
    coords = pca.fit_transform(scaled)

    fig, ax = plt.subplots(figsize=(8, 6))
    ax.scatter(coords[:, 0], coords[:, 1], s=80, color="#1b9e77", edgecolor="black")
    for (x, y), label in zip(coords, wide.index):
        ax.annotate(label, (x, y), fontsize=8, xytext=(4, 4), textcoords="offset points")
    ax.set_xlabel(f"PC1 ({pca.explained_variance_ratio_[0]*100:.1f}% Varianz)")
    ax.set_ylabel(f"PC2 ({pca.explained_variance_ratio_[1]*100:.1f}% Varianz)")
    ax.set_title("PCA der Optimierungsläufe im Parameterraum")
    fig.tight_layout()
    fig.savefig(outdir / "pca_runs.png", dpi=200)
    plt.close(fig)


# --------------------------------------------------------------------------- #
# Report
# --------------------------------------------------------------------------- #
def write_report(long_df, summary, overview, outdir: Path, n_files: int):
    lines = []
    lines.append("# Analysis Report: Optimized Model Parameters\n")
    lines.append(f"- Number of files read (runs): **{n_files}**")
    lines.append(f"- Number of parameters: **{long_df['parameter'].nunique()}**")
    lines.append(f"- Regions: {', '.join(sorted(long_df['region'].unique()))}")
    lines.append(f"- Mechanisms: {', '.join(sorted(long_df['mechanism'].unique()))}\n")

    lines.append("## Overview by Region and Mechanism\n")
    lines.append(overview.to_markdown(index=False))
    lines.append("")

    if n_files > 1:
        unstable = summary[summary["cv_percent"] > 20].sort_values("cv_percent", ascending=False)
        lines.append("## Convergence / Consistency Across Runs\n")
        if len(unstable):
            lines.append(
                f"{len(unstable)} von {len(summary)} Parametes show a "
                "Coefficient of variation  (CV) > 20 % across runs and "
                "should be reviewed in terms of identifiability and sensitivity:\n"
            )
            lines.append(
                unstable[["parameter", "mean", "std", "cv_percent"]]
                .round(4)
                .to_markdown(index=False)
            )
        else:
            lines.append("All parameters show CV ≤ 20 % across runs (good Convergence).")
        lines.append("")
    else:
        lines.append(
            "## Note\n\nOnly a single parameter file was imported. "
            "Statistics on variation across repetitions (std., CV, correlation, PCA) "
            "require multiple files (e.g., multiple optimization runs/seeds) and "
            "were therefore not calculated, or only to a limited extent.\n"
        )

    lines.append("## Files Created\n")
    lines.append("- `long_format.csv` – processed raw data (tidy/long format)")
    lines.append("- `summary_stats.csv` – Key Figures by Parameter")
    lines.append("- `parameter_overview_by_region.png` – Overview Plot")
    if n_files > 1:
        lines.append("- `parameter_boxplots_across_runs.png` – Variance by Parameter")
        lines.append("- `parameter_correlation_heatmap.png` – Parameter Correlations")
    if n_files >= 3:
        lines.append("- `pca_runs.png` – PCA of runs")

    (outdir / "analysis_report.md").write_text("\n".join(lines), encoding="utf-8")


# --------------------------------------------------------------------------- #
# Main Program
# --------------------------------------------------------------------------- #
def main():
    parser = argparse.ArgumentParser(
        description="Scientific Analysis of best_parameters.csv Files"
        "(BluePyOpt-style model parameters: ‘ephys.<mechanism>.<region>.<property>’)."
    )
    parser.add_argument(
        "inputs", nargs="+",
        help="One or more CSV files or glob patterns (e.g., ‘results/*.csv’).",
    )
    parser.add_argument(
        "-o", "--outdir", default="analysis_output",
        help="Destination folder for results (Standard: analysis_output)",
    )
    args = parser.parse_args()

    outdir = Path(args.outdir)
    outdir.mkdir(parents=True, exist_ok=True)

    files = resolve_input_files(args.inputs)
    if not files:
        print("Error: No matching files found.", file=sys.stderr)
        sys.exit(1)
    print(f"Read {len(files)} file(s): {[str(f) for f in files]}")

    long_df = load_files(files)
    summary = compute_summary(long_df)
    overview = region_mechanism_overview(long_df)

    long_df.to_csv(outdir / "long_format.csv", index=False)
    summary.to_csv(outdir / "summary_stats.csv", index=False)

    single_run = len(files) == 1
    plot_parameter_bar(long_df, outdir, single_run)
    if not single_run:
        plot_boxplots(long_df, outdir)
        plot_correlation_heatmap(long_df, outdir)
        if len(files) >= 3:
            plot_pca(long_df, outdir)

    write_report(long_df, summary, overview, outdir, n_files=len(files))
    print(f"Done. Results in: {outdir.resolve()}")


if __name__ == "__main__":
    main()
